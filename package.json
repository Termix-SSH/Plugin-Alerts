{
  "name": "@termix-plugin/alerts",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "build": "termix-plugin build",
    "test": "termix-plugin test",
    "typecheck": "tsc -p .",
    "validate": "termix-plugin validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "announce": "node scripts/announce.ts new",
    "announce:build": "node scripts/announce.ts build",
    "announce:check": "node scripts/announce.ts check"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@termix-ssh/plugin-sdk": "^1.0.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "better-sqlite3": "^13.0.3",
    "husky": "^9.1.7",
    "i18next": "^26.4.2",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.2.0",
    "prettier": "3.9.9",
    "react-i18next": "^17.0.16",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@termix-ssh/plugin-sdk": "^1.0.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "sonner": "^2.0.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,css,md}": [
      "prettier --write"
    ],
    "announcements/*.md": [
      "node scripts/announce.ts build --stage"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
